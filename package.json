{
	"name": "@replynodes/n8n-nodes-replynodes",
	"version": "0.1.4",
	"description": "n8n node for ReplyNodes: turn any URL into Markdown, get brand data and logos from a domain, and search, scrape, map, or crawl the web. Free operations need no API key.",
	"license": "MIT",
	"homepage": "https://github.com/replynodes-ai/n8n-nodes-replynodes#readme",
	"bugs": {
		"url": "https://github.com/replynodes-ai/n8n-nodes-replynodes/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"replynodes",
		"url-to-markdown",
		"web-scraping",
		"web-search",
		"brand-data",
		"logo-api",
		"ai-agent-tools"
	],
	"author": {
		"name": "ReplyNodes",
		"email": "dnanh2011@gmail.com",
		"url": "https://replynodes.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/replynodes-ai/n8n-nodes-replynodes.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run test:unit && npm run test:contract",
		"test:unit": "tsx --test tests/unit/*.test.cts",
		"test:contract": "tsx --test tests/contract/*.test.cts",
		"smoke": "tsx scripts/smoke.cts",
		"audit:production": "npm audit --omit=dev --audit-level=high",
		"check": "npm run lint && npm test && npm run build && npm run audit:production && npm pack --dry-run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ReplyNodesApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ReplyNodes/ReplyNodes.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.1",
		"eslint": "9.32.0",
		"n8n-workflow": "2.44.1",
		"prettier": "3.6.2",
		"release-it": "21.1.1",
		"tsx": "4.23.15",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
